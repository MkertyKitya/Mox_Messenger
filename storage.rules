rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /chat_media/{chatRoomId}/{allPaths=**} {
      // Разрешить чтение и запись авторизованным пользователям (ограничение до 50MB)
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 50 * 1024 * 1024;
    }
  }
}
